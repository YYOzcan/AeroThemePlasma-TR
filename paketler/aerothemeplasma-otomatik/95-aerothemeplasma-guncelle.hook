# KDE Plasma / KWin / Qt güncellendiğinde AeroThemePlasma'yı yeni sürüme göre yeniden derler.
# Derleme işlem bittikten sonra arka planda (systemd) yapılır; ayarlar ve Türkçe çeviriler korunur.
[Trigger]
Operation = Upgrade
Type = Package
Target = kwin
Target = kdecoration
Target = plasma-workspace
Target = plasma-desktop
Target = libplasma
Target = kscreenlocker
Target = libksysguard
Target = plasma-activities
Target = plasma-activities-stats
Target = plasma5support
Target = layer-shell-qt
Target = polkit-qt6
Target = plasma-nm
Target = plasma-pa
Target = powerdevil
Target = kpipewire
Target = systemsettings
Target = qt6-base
Target = qt6-declarative
Target = qt6-wayland
Target = qt6-5compat
Target = qt6-svg
Target = sddm
Target = libaero-qt
Target = libaero-qt-git

[Action]
Description = AeroThemePlasma yeniden derlemesi planlanıyor (Türkçe, ayarlar korunur)...
When = PostTransaction
Exec = /usr/bin/systemctl start --no-block aerothemeplasma-guncelle.service
