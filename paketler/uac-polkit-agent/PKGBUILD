# Yerel paket: AeroThemePlasma (install.sh ile aynı CMake adımları)
pkgname=uac-polkit-agent
pkgver=6.8.0
pkgrel=202611070128
pkgdesc="Windows tarzı UAC polkit ajanı"
arch=(x86_64)
url="https://gitgud.io/aeroshell"
license=("GPL-2.0-or-later")
provides=()
conflicts=()
groups=(aerothemeplasma-yerel)
options=(!debug !lto)
makedepends=(git cmake ninja extra-cmake-modules)
source=("kaynak::git+file://$HOME/AeroKurulum/repos/uac-polkit-agent#branch=Plasma/6.8")
sha256sums=(SKIP)

prepare() {
  # Türkçe yerelleştirme yamaları
  python3 $HOME/AeroKurulum/turkce/araclar/yama.py uac-polkit-agent "$srcdir/kaynak"
}

build() {
  cmake -G Ninja -S kaynak -B build -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF -DCMAKE_INSTALL_LIBEXECDIR=lib
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
