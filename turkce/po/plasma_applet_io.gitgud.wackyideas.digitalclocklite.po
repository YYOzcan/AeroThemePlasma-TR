#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:42
msgid "Tip: if you travel frequently, add your home time zone to this list. It will only appear when you change the systemwide time zone to something else."
msgstr "İpucu: Sık seyahat ediyorsanız evinizin saat dilimini bu listeye ekleyin. Yalnızca sistem genelindeki saat dilimini başka bir dilime değiştirdiğinizde görünür."

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:78
msgid "Clock is currently using this time zone"
msgstr "Saat şu anda bu zaman dilimini kullanıyor"

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:80
msgctxt "@label This list item shows a time zone city name that is identical to the local time zone's city, and will be hidden in the timezone display in the plasmoid's popup"
msgid "Hidden while this is the local time zone's city"
msgstr "Bu yerel zaman diliminin şehriyken gizli"

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:105
msgid "Switch Systemwide Time Zone…"
msgstr "Sistem Geneli Zaman Dilimini Değiştir…"

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:117
msgid "Remove this time zone"
msgstr "Bu zaman dilimini kaldır"

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:127
msgid "Systemwide Time Zone"
msgstr "Sistem Geneli Zaman Dilimi"

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:127
msgid "Additional Time Zones"
msgstr "Ek Zaman Dilimleri"

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:140
msgid "Add more time zones to display all of them in the applet's pop-up, or use one of them for the clock itself"
msgstr "Tümünü uygulamanın açılır penceresinde görüntülemek için daha fazla zaman dilimi ekleyin veya bunlardan birini saatin kendisi için kullanın"

#. Explicitly set so it gets reversed for LTR mode
#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:149
msgid "Add Time Zones…"
msgstr "Saat Dilimi Ekle…"

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:159
msgid "Switch displayed time zone by scrolling over clock applet"
msgstr "Saat uygulaması üzerinde gezinerek görüntülenen zaman dilimini değiştirin"

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:166
msgid "Using this feature does not change the systemwide time zone. When you travel, switch the systemwide time zone instead."
msgstr "Bu özelliği kullanmak, sistem geneli zaman dilimini değiştirmez. Bunun yerine yolculuk yaparken sistem geneli zaman dilimine geçin."

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:188
msgid "Add More Timezones"
msgstr "Daha Fazla Saat Dilimi Ekle"

#: aerothemeplasma/plasma/plasmoids/io.gitgud.wackyideas.digitalclocklite/contents/ui/configTimeZones.qml:199
msgid "At least one time zone needs to be enabled. Your local timezone was enabled automatically."
msgstr "En az bir saat diliminin etkin olması gerekir. Yerel saat diliminiz kendiliğinden etkinleştirildi."

